{
    "name": "bookstore-vue",
    "version": "0.0.0",
    "scripts": {
        "dev": "vite --host",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "generate-devbook-client": "openapi-generator-cli generate -i ./src/api/devbook.api.yaml -o ./src/api/devbookClient -g typescript-axios --additional-properties=supportsES6=true --ignore-file-override ./src/api/devbookClient/.openapi-generator-ignore"
    },
    "dependencies": {
        "@mdi/font": "7.4.47",
        "@primevue/themes": "4.4.1",
        "@tailwindcss/postcss": "4.1.16",
        "@tailwindcss/vite": "4.1.16",
        "@vueuse/core": "14.0.0",
        "axios": "1.13.1",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "lucide-vue-next": "0.552.0",
        "pinia": "3.0.3",
        "primeicons": "7.0.0",
        "primevue": "4.4.1",
        "radix-vue": "1.9.17",
        "roboto-fontface": "0.10.0",
        "swiper": "12.0.3",
        "tailwind-merge": "3.3.1",
        "tailwindcss-animate": "1.0.7",
        "tailwindcss-primeui": "0.6.1",
        "uuid": "13.0.0",
        "vee-validate": "4.15.1",
        "vue": "3.5.22",
        "vue-router": "4.6.3",
        "yup": "1.7.1"
    },
    "devDependencies": {
        "@babel/types": "7.28.5",
        "@openapitools/openapi-generator-cli": "2.25.0",
        "@primevue/auto-import-resolver": "4.4.1",
        "@types/node": "24.10.0",
        "@types/uuid": "11.0.0",
        "@vitejs/plugin-vue": "6.0.1",
        "postcss": "8.5.6",
        "prettier": "3.6.2",
        "sass": "1.93.3",
        "tailwindcss": "4.1.16",
        "typescript": "5.9.3",
        "unplugin-fonts": "1.4.0",
        "unplugin-vue-components": "30.0.0",
        "vite": "7.1.12",
        "vue-tsc": "3.1.3"
    }
}
