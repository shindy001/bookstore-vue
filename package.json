{
    "name": "bookstore-vue",
    "version": "0.0.0",
    "scripts": {
        "dev": "vite --host",
        "build": "vue-tsc --noEmit && vite build",
        "preview": "vite preview",
        "generate-devbook-client": "openapi-generator-cli generate -i ./src/api/devbook.api.yaml -o ./src/api/devbookClient -g typescript-axios --additional-properties=supportsES6=true --ignore-file-override ./src/api/devbookClient/.openapi-generator-ignore"
    },
    "dependencies": {
        "@mdi/font": "7.4.47",
        "@primevue/themes": "4.0.4",
        "@vueuse/core": "^10.11.1",
        "axios": "^1.8.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^0.424.0",
        "pinia": "^2.3.1",
        "primeicons": "^7.0.0",
        "primevue": "4.0.4",
        "radix-vue": "^1.9.17",
        "roboto-fontface": "^0.10.0",
        "swiper": "^11.2.6",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-primeui": "^0.3.4",
        "uuid": "^10.0.0",
        "vee-validate": "^4.15.0",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0",
        "yup": "^1.6.1"
    },
    "devDependencies": {
        "@babel/types": "^7.27.0",
        "@openapitools/openapi-generator-cli": "^2.18.4",
        "@primevue/auto-import-resolver": "4.0.4",
        "@types/node": "^22.13.16",
        "@types/uuid": "^10.0.0",
        "@vitejs/plugin-vue": "^5.2.3",
        "autoprefixer": "^10.4.21",
        "postcss": "^8.5.3",
        "prettier": "3.3.3",
        "sass": "^1.86.1",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.8.2",
        "unplugin-fonts": "^1.3.1",
        "unplugin-vue-components": "^28.4.1",
        "vite": "^6.2.4",
        "vue-tsc": "^2.2.8"
    }
}
